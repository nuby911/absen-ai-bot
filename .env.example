# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smart_school_attendance

# Backend Core
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/smart_school_attendance
JWT_SECRET=smart-school-attendance-dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=uploads

# Face Recognition
FACE_SIMILARITY_THRESHOLD=0.55
FACE_ENGINE_MODE=auto

# WhatsApp Gateway (WAHA)
WHATSAPP_PROVIDER_MODE=mock
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default

# AI Chatbot LLM (Gemini)
LLM_PROVIDER_MODE=fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Web Admin (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
